# Estado do aluno: nasce na primeira sessão, não vai para o repositório.
trilha/estado.json
trilha/fila.jsonl
trilha/aluno.md
trilha/tmp/
# O acesso à 202 mora em ~/.trilha-202, fora daqui. Estas linhas são rede de
# segurança para quem salvar as credenciais dentro da pasta por engano.
credenciais.json
.env
.env.local
*.tmp
.DS_Store
trilha/seq
# Desliga a atualização automática da sala (lib/atualizar.js): para a cópia de
# quem desenvolve o harness, que não pode andar sozinha.
trilha/sem-atualizar

# Saída de ferramentas de navegador de quem testa; não é da sala.
.playwright-mcp/

# O Claude Code cria este arquivo quando o aluno escolhe "não perguntar de novo"
# num pedido de permissão. Sem esta linha, todo evento dele saía como harness
# alterado. As regras de negar do settings.json continuam valendo por cima dele.
.claude/settings.local.json

# A trava da sincronização do modo Codex (lib/codex/sessao.js), e a trava velha renomeada antes de apagada.
trilha/codex.lock
trilha/codex.lock.*

# A cópia da conversa de cada chat (lib/conversas.js): o fechar pelo X do aplicativo apaga o original, e a avaliação
# pendente lê daqui. É do aluno e da máquina dele.
trilha/conversas/
